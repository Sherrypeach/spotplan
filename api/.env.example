# App
NODE_ENV=local
# dev only: false keeps the session over plain http. Ignored in prod.
COOKIE_SECURE=true
APP_NAME=spotplan-api
APP_VERSION=1.0.0
# The host may inject PORT, which wins; APP_PORT is used only without it; default 3000.
PORT=3000
# Address to listen on; unset means every address. 127.0.0.1 keeps the API behind the web app's /api proxy.
LISTEN_HOST=
# Where the web app runs; the password reset email links to <this>/auth/reset. Required in prod.
WEB_APP_URL=http://localhost:5000
# Comma-separated origins allowed to read (GET/HEAD, no cookies) from another
# site. Not needed for the web app: it calls the API through its own /api proxy.
CORS_ORIGINS=

# Auth
SALT_ROUNDS=10
# At least 32 characters, e.g. `openssl rand -hex 32`. The app won't start without it.
JWT_SECRET=
SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=15
RESET_TOKEN_TTL_MINUTES=10
# Which proxy may pass on the caller's address (Express "trust proxy"); the web server on the same machine by default.
TRUST_PROXY=loopback

# Database — DATABASE_URL wins when set ; otherwise the discrete vars.
# DATABASE_SSL=true for managed Postgres (Neon, Render, etc.).
DATABASE_URL=
DATABASE_SSL=false
# Path to the provider's CA certificate, so the database's certificate is checked. Required in prod with DATABASE_SSL=true.
DATABASE_SSL_CA=
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=seating_dev
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=postgres

# Email (SendGrid). Empty key = emails are logged, not sent.
SENDGRID_API_KEY=
# Required in prod.
DEFAULT_EMAIL_FROM=no-reply@example.com

# Seeder
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

