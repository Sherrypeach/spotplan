{
  "name": "spotplan-api",
  "version": "2.0.0",
  "description": "API for SpotPlan: teacher accounts and their classes.",
  "author": "Cassandra Perche",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "generate-typings": "ts-node -r tsconfig-paths/register src/infrastructure/graphql/generate-typings.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d src/infrastructure/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "ts-node ./node_modules/typeorm/cli migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/database/seeds/run-seeds.ts",
    "teacher:create": "ts-node -r tsconfig-paths/register src/infrastructure/database/seeds/create-teacher.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:run:prod": "typeorm migration:run -d dist/infrastructure/database/data-source.js",
    "seed:prod": "node dist/infrastructure/database/seeds/run-seeds.js",
    "demo:prod": "node dist/infrastructure/database/seeds/ensure-demo.js"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "graphql": "^16.12.0",
    "helmet": "^8.3.0",
    "joi": "^18.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "12.1.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-morph": "28.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "<rootDir>/../jest.esm-transform.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs/)"
    ]
  },
  "overrides": {
    "qs": "6.16.0",
    "handlebars": "4.7.9",
    "http-cache-semantics": "4.2.0",
    "update-browserslist-db": "1.3.3",
    "caniuse-lite": "1.0.30001814",
    "baseline-browser-mapping": "2.11.27",
    "node-releases": "2.0.57",
    "electron-to-chromium": "1.5.443"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
